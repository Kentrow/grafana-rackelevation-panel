{
  "uid": "rack-elevation-live",
  "title": "Rack elevation live (Prometheus)",
  "tags": [
    "rack-elevation"
  ],
  "editable": true,
  "graphTooltip": 0,
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "timepicker": {},
  "timezone": "",
  "refresh": "10s",
  "links": [],
  "annotations": {
    "list": []
  },
  "templating": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "kentrow-rackelevation-panel",
      "title": "One query with group_left: status only",
      "description": "device_up joined to netbox_device_info in PromQL, status mapped to Value. Devices without device_up (patch panels) are dropped by the join.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 28,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "device_up * on (device) group_left (rack, position, u_height, face, is_full_depth, role, model) netbox_device_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "racks",
          "expr": "netbox_rack_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "alerts",
          "expr": "ALERTS{alertstate=\"firing\", device!=\"\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "columns": {
          "status": "Value #A"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 65
              }
            ]
          }
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "kentrow-rackelevation-panel",
      "title": "Three queries joined by field: status and temperature",
      "description": "netbox_device_info, device_up and device_temperature_celsius joined on device by the Join by field transformation (applied to A, B and C only). Thresholds on the temperature give the colour.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 28,
        "w": 24,
        "x": 0,
        "y": 28
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "A",
          "expr": "netbox_device_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "B",
          "expr": "device_up",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "C",
          "expr": "device_temperature_celsius",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "racks",
          "expr": "netbox_rack_info",
          "instant": true,
          "range": false,
          "format": "table"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "refId": "alerts",
          "expr": "ALERTS{alertstate=\"firing\", device!=\"\"}",
          "instant": true,
          "range": false,
          "format": "table"
        }
      ],
      "options": {
        "columns": {
          "status": "Value #B"
        },
        "valueFields": [
          "Value #C"
        ],
        "label": [
          "name",
          "value"
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 50
              },
              {
                "color": "red",
                "value": 65
              }
            ]
          }
        },
        "overrides": []
      },
      "transformations": [
        {
          "id": "joinByField",
          "options": {
            "byField": "device",
            "mode": "outerTabular"
          },
          "filter": {
            "id": "byRefId",
            "options": "/^(A|B|C)$/"
          }
        }
      ]
    }
  ]
}
